.vscode
.vscode/settings.json

# Portable local environment (downloaded tooling, do not commit)
.bsat_local/

# Dev repo keeps the PATH courtesy string committed (replaced by a template at the public cut)
code/model/path_license.txt

# Working paper: reference only, never committed (sensitive, pre-publication)
**/working_paper*.tex

# Pipeline intermediates (regenerated by code/processing/main.R), except the derived files that
# replace raw inputs the repository does not distribute
data/interim/*
!data/interim/tariff_ave_region.csv
!data/interim/export_taxes_comm_reg.csv
!data/interim/commodity_hs6_mapping.csv
!data/interim/NTM_IMP_ave_region.csv
!data/interim/NTM_EXP_ave_region.csv

# Raw files not distributed with the repository (size or source terms); see data/raw/README.md
data/raw/trade_barriers/BACI_HS92_Y2014_V202401b.csv
data/raw/trade_barriers/tariff_ave_2014_WITS.csv
data/raw/trade_barriers/tariff_ave_WITS_2023.csv
data/raw/trade_barriers/ag_hs_products.csv
data/raw/trade_barriers/ag_tariff_USA_2014.xls

# Model run artifacts
code/model/Input/
code/model/Input.zip
code/model/Output/
code/model/Output_*/
code/model/Output.zip
code/model/Results_*/

# R and Python session cruft
.Rhistory
.RData
__pycache__/

# Model output packages written by scripts/run_model_*
output/
.pytest_cache/

# Quarto site build (regenerated by quarto render doc)
doc/_site/
doc/.quarto/
